# Application
APP_NAME=Lai_agent
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database URL: use SQLite locally or PostgreSQL in production.
DATABASE_URL=sqlite:///./content.db
DATABASE_PATH=content.db
CHECKPOINT_PATH=content_engine_checkpoints.db

# Google AI / Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# Tavily research
TAVILY_API_KEY=

# Image and audio generation
CLOUDFLARE_SECRET=
# Legacy compatibility alias: CLOUDFLARE_SCERET
CLOUDFLARE_URL=
IMAGE_MODEL=
USE_GEMINI_IMAGE=false
AUDIO_MODEL=

# X OAuth/API
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/publishing/X/callback

# LinkedIn OAuth/API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/publishing/LinkedIn/callback
LINKEDIN_API_VERSION=20240201

# Security foundation. Authentication is intentionally deferred.
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS: comma-separated values
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
